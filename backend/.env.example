NODE_ENV=development
PORT=4000
# Local Docker database, or a MongoDB Atlas string: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fitforge
MONGO_URI=mongodb://localhost:27017/fitforge
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
CLIENT_ORIGIN=http://localhost:3000
LOG_LEVEL=http

# Uploaded files (profile photos, exercise images). "local" saves under UPLOAD_DIR on this machine.
# For S3 set STORAGE_DRIVER=s3 plus the bucket and region; keys can come from here or the AWS
# credential chain. The bucket stays private: the API hands out 5-minute signed links.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public website address, used in email links (password reset). Required in production.
APP_URL=http://localhost:3000
# Outgoing email. Set ONE of these (Resend is used if both are set). Without either (development
# only) emails are written to the API log instead.
# Resend API key from resend.com -> API Keys (starts with re_).
RESEND_API_KEY=
# Or SMTP, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
# Must be an address on a domain you verified with your email provider. For a quick Resend test
# without a domain use: FitForge <onboarding@resend.dev> (it only delivers to your own address).
MAIL_FROM=FitForge <no-reply@fitforge.app>

# Error tracking (optional): a Sentry project's DSN. Unexpected server errors are reported there.
SENTRY_DSN=

# Proxies in front of the API that add X-Forwarded-For: 1 locally, 2 for Vercel -> Render.
TRUST_PROXY=1
# Login/sign-up attempts per IP per 15 minutes. Keep 20 in production.
AUTH_RATE_LIMIT=20
